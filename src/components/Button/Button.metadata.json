{
  "name": "Button",
  "status": "experimental",
  "version": "0.1.0",
  "description": "Triggers an action. Use a link for navigation.",
  "element": "button",
  "variants": ["primary", "secondary", "ghost", "danger"],
  "sizes": ["sm", "md", "lg"],
  "states": ["default", "hover", "active", "focus-visible", "disabled", "loading"],
  "props": {
    "variant": { "type": "enum", "default": "primary" },
    "size": { "type": "enum", "default": "md" },
    "loading": { "type": "boolean", "default": false },
    "fullWidth": { "type": "boolean", "default": false },
    "leftIcon": { "type": "ReactNode", "default": null },
    "rightIcon": { "type": "ReactNode", "default": null }
  },
  "accessibility": {
    "role": "button (native)",
    "keyboard": ["Enter", "Space"],
    "iconOnlyRequires": "aria-label",
    "loading": "aria-busy + aria-disabled, remains focusable",
    "reducedMotion": "spinner slows under prefers-reduced-motion"
  },
  "tokens": "src/tokens/tokens.css (--sg-button-*)"
}
